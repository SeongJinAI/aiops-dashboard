# ============================
# 공통 설정
# ============================
PORT=8000
HOST=0.0.0.0

# 운영 모드: "local" (기본, JSONL 파일 직접 읽기) | "saas" (DB + HTTP 수집)
AIOPS_MODE=local

# CORS 허용 Origins (쉼표 구분)
AIOPS_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 대시보드 공개 URL — Hook 설치 명령과 install.sh가 가리킬 베이스 URL.
# 운영 배포에서 사용자가 본인 머신에서 curl로 받게 되므로 외부에서 도달 가능한 URL이어야 한다.
# 미설정 시 요청의 X-Forwarded-Proto/Host 또는 Host 헤더로 자동 추론.
# AIOPS_PUBLIC_URL=https://dashboard.example.com

# ============================
# Local 모드 전용
# ============================

# JSONL 로그 디렉토리 (폴백 — 활성 프로젝트 .aiops/ 우선)
LOG_DIR=./logs

# SQLAlchemy DATABASE_URL (운영 표준 — PostgreSQL)
# 예: postgresql+asyncpg://nova:nova@localhost:5432/nova
# 미설정 시 아래 DB_PATH로 SQLite 폴백 (dev 단독 실행에 한해).
DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5432/nova

# (폴백) SQLite 파일 경로 — DATABASE_URL이 비었을 때만 사용
DB_PATH=./data/aiops.db

# PostgreSQL (docker-compose에서 자동 사용)
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
POSTGRES_DB=nova

# 프로젝트 목록 파일
PROJECTS_FILE=./data/projects.json

# 레포 경로 (로컬 파일시스템)
PROJECT_REPO=
TEST_REPO=
GOVERNANCE_REPO=
KNOWLEDGE_REPO=

# ============================
# SaaS 모드 전용
# ============================

# API 키: "tenant_id:api_key" 쉼표 구분
# AIOPS_API_KEYS=my-team:sk-abc123,other-team:sk-xyz789

# JWT 설정
# JWT_SECRET=change-this-to-a-secure-random-string
# JWT_EXPIRE_HOURS=24

# ============================
# Hook 환경변수 (개발자 로컬 ~/.claude/.env에 설정)
# ============================

# AIOPS_REMOTE_URL=https://dashboard.example.com
# AIOPS_API_KEY=sk-abc123
# AIOPS_TENANT_ID=my-team
